{
  "name": "griffix-racing",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "build": "node scripts/ensure-product-slugs.mjs --check && node scripts/generate-product-pages.mjs",
    "build:samples": "node scripts/generate-product-pages.mjs --sample-only",
    "slugs": "node scripts/ensure-product-slugs.mjs",
    "slugs:check": "node scripts/ensure-product-slugs.mjs --check",
    "build:vercel-skip": "node -e \"console.log('Static HTML is committed; Vercel skips install/build')\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.14",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "puppeteer": "^24.37.5"
  }
}
